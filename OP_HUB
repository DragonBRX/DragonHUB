local function _makeSection(tab, secName)
    if secName and secName~="" then _addSep(tab, secName) end
    local sec={}
    sec.AddToggle    = function(_,o) return _addToggle(tab,o) end
    sec.AddButton    = function(_,o) return _addButton(tab,o) end
    sec.AddSlider    = function(_,o) return _addSlider(tab,o) end
    sec.AddDropdown  = function(_,o) return _addDropdown(tab,o) end
    sec.AddParagraph = function(_,o) return _addParagraph(tab,o) end
    sec.AddInput     = function(_,o) return _addInput(tab,o) end
    sec.AddDivider   = function(_)   return _addDivider(tab) end
    sec.AddSection   = function(_,n,_2) return _makeSection(tab, type(n)=="string" and n or (type(n)=="table" and n.Name or "")) end
    return sec
end

