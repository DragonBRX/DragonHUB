_G.PullEnabled     = false
_G.PullRadius      = 80
_G.PullMethod      = "WarpNPC"
_G.PullDelay       = 0.3
_G.PullFilterName  = ""

local _pullAnchorCFrame = nil
local _pullAnchorConn = nil

local function myHRP()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function StartPullAnchor()
    local h = myHRP()
    if not h then return end
    _pullAnchorCFrame = h.CFrame
    if _pullAnchorConn then _pullAnchorConn:Disconnect() end
    _pullAnchorConn = RunService.Heartbeat:Connect(function()
        if not _G.PullEnabled or not _G.DRAGONHUB_ACTIVE then
            if _pullAnchorConn then _pullAnchorConn:Disconnect() _pullAnchorConn = nil end
            _pullAnchorCFrame = nil
            return
        end
        local hrpNow = myHRP()
        if hrpNow and _pullAnchorCFrame then
            hrpNow.CFrame = _pullAnchorCFrame
            hrpNow.AssemblyLinearVelocity = Vector3.zero
            hrpNow.AssemblyAngularVelocity = Vector3.zero
        end
    end)
end

local function StopPullAnchor()
    if _pullAnchorConn then
        _pullAnchorConn:Disconnect()
        _pullAnchorConn = nil
    end
    _pullAnchorCFrame = nil
end

local function GetNearbyNPCs(radius, nameFilter)
    local result = {}
    local npcsFolder = workspace:FindFirstChild("NPCs")
    if not npcsFolder then return result end
    local h = myHRP()
    if not h then return result end
    local myPos = h.Position
    local r = radius or _G.PullRadius or 80
    for _, npc in ipairs(npcsFolder:GetChildren()) do
        local hum = npc:FindFirstChild("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        local npcHRP = npc:FindFirstChild("HumanoidRootPart")
        if not npcHRP then continue end
        if nameFilter and nameFilter ~= "" then
            local n = npc.Name:lower():gsub("%d+",""):match("^%s*(.-)%s*$")
            if not n:find(nameFilter:lower()) then continue end
        end
        local dist = (npcHRP.Position - myPos).Magnitude
        if dist <= r then
            table.insert(result, npc)
        end
    end
    return result
end

local function PullMethod_WarpNPC(npcs)
    -- WarpNPC pelo cliente não funciona (servidor controla NPC HRP)
    -- Substituto: AggroAttack — visita cada NPC, dá um hit, volta
    local h = myHRP()
    if not h then return end
    local origin = _pullAnchorCFrame or h.CFrame
    for _, npc in ipairs(npcs) do
        local npcHRP = npc:FindFirstChild("HumanoidRootPart")
        local hum   = npc:FindFirstChild("Humanoid")
        if not npcHRP or not hum or hum.Health <= 0 then continue end
        pcall(function()
            local dest = npcHRP.CFrame * CFrame.new(0, 0, 3)
            TPInstant(dest)
            CombatRemote:FireServer(npcHRP.Position)
        end)
        task.wait(0.05)
    end
    -- Volta para posição âncora
    pcall(function() TPInstant(origin) end)
end

local function PullMethod_TeleportPlayer(npcs)
    local origin = _pullAnchorCFrame or (myHRP() and myHRP().CFrame)
    if not origin then return end
    if _pullAnchorConn then _pullAnchorConn:Disconnect() _pullAnchorConn = nil end
    for _, npc in ipairs(npcs) do
        local npcHRP = npc:FindFirstChild("HumanoidRootPart")
        if npcHRP then
            pcall(function()
                TPInstant(npcHRP.CFrame * CFrame.new(0, 0, 4))
                task.wait(0.05)
                CombatRemote:FireServer(npcHRP.Position)
            end)
        end
    end
    task.wait(0.05)
    TPInstant(origin)
    if _G.PullEnabled then
        _pullAnchorCFrame = origin
        _pullAnchorConn = RunService.Heartbeat:Connect(function()
            if not _G.PullEnabled or not _G.DRAGONHUB_ACTIVE then
                if _pullAnchorConn then _pullAnchorConn:Disconnect() _pullAnchorConn = nil end
                return
            end
            local hrpNow = myHRP()
            if hrpNow and _pullAnchorCFrame then
                hrpNow.CFrame = _pullAnchorCFrame
                hrpNow.AssemblyLinearVelocity = Vector3.zero
                hrpNow.AssemblyAngularVelocity = Vector3.zero
            end
        end)
    end
end

local function PullMethod_VelocityPush(npcs)
    -- VelocityPush via cliente também é ignorado pelo servidor
    -- Mesmo padrão: agro em cada NPC para forçar perseguição
    local h = myHRP()
    if not h then return end
    local origin = _pullAnchorCFrame or h.CFrame
    for _, npc in ipairs(npcs) do
        local npcHRP = npc:FindFirstChild("HumanoidRootPart")
        local hum   = npc:FindFirstChild("Humanoid")
        if not npcHRP or not hum or hum.Health <= 0 then continue end
        pcall(function()
            local dest = npcHRP.CFrame * CFrame.new(0, 0, 3)
            TPInstant(dest)
            CombatRemote:FireServer(npcHRP.Position)
        end)
        task.wait(0.05)
    end
    pcall(function() TPInstant(origin) end)
end

local function DoPull()
    local npcs = GetNearbyNPCs(_G.PullRadius, _G.PullFilterName)
    if #npcs == 0 then return end
    local method = _G.PullMethod or "WarpNPC"
    if method == "WarpNPC" then
        PullMethod_WarpNPC(npcs)
    elseif method == "TeleportPlayer" then
        PullMethod_TeleportPlayer(npcs)
    elseif method == "VelocityPush" then
        PullMethod_VelocityPush(npcs)
    elseif method == "Combinado" then
        -- Agro em todos + espera breve para eles começarem a perseguir
        PullMethod_WarpNPC(npcs)
        task.wait(0.1)
    end
end

