        end
    end
end)

local function moverParaNPC(target, islandName, islandData)
    -- Se Pull ativo, não move o personagem para o NPC
    if _G.PullEnabled then return true end
    local myChar = LP.Character
    if not myChar then return false end
    local myHum = myChar:FindFirstChildOfClass("Humanoid")
    if not myHum or myHum.Health <= 0 then
        LP.CharacterAdded:Wait()
        task.wait(2)
        return false
    end
    local myHrp = hrp()
    if not myHrp then return false end
    if not target or not target.Parent then return false end
    local targetHum = target:FindFirstChild("Humanoid")
    if not targetHum or targetHum.Health <= 0 then return false end
    if islandData and (myHrp.Position - islandData.Position).Magnitude > 780 then
        TeleportToIsland(islandName)
        task.wait(2)
        myHrp = hrp()
        if not myHrp then return false end
    end
    local cok = target:FindFirstChild("HumanoidRootPart")
    if cok then
        TP(cok.CFrame * getAttackPos())
    else
        local pivotPos = target.WorldPivot.Position
        TP(CFrame.new(pivotPos + Vector3.new(0, 3, 0)))
    end
    -- Aguarda chegada antes de liberar o loop de ataque
    if _G.SelectModeTP == "Tween" then
        local destPos = cok and (cok.CFrame * getAttackPos()).Position or (target.WorldPivot.Position + Vector3.new(0,3,0))
        WaitArrival(destPos, 6, 3)
    else
        task.wait(math.max(TELEPORT_COOLDOWN, 0.1))
    end
    return true
end

