-- Loop principal do Farm Global (COMBINADO)
local function _GF_Loop(updateBar)
    local lastIsland    = ""
    local noEnemyCount  = 0
    local startTime     = tick()

    while _G.GlobalNPCFarm and _G.DRAGONHUB_ACTIVE do
        RunService.Heartbeat:Wait()
        pcall(function()
            if not IsCharacterOk() then
                WaitForCharacter()
                return
            end

            local currentLevel = _GF_GetLevel()
            local questData    = _GF_GetQuestForLevel()
            if not questData then return end

            local currentIsland = questData.island
            local h = hrp()
            if not h then return end

            -- Teleporte de ilha quando muda
            if lastIsland ~= currentIsland then
                lastIsland = currentIsland
                TeleportToIsland(currentIsland)
                task.wait(2)
            end

            -- Encontra NPC alvo pelo tipo
            local npcTypeX = questData.npcType == "SlimeWarrior" and "Slime" or questData.npcType
            local target = findNPC(npcTypeX, "IncludeUnderscore")

            if target and target:FindFirstChild("Humanoid") and target.Humanoid.Health > 0 then
                noEnemyCount = 0

                -- Move ate o NPC e ataca usando SmartAttack
                local npcPos = target.WorldPivot.Position
                local islandName, islandData = GetClosestIsland(npcPos)

                if moverParaNPC(target, islandName, islandData) then
                    _G._InstantTarget = target
                    repeat
                        if not _G.GlobalNPCFarm or not _G.DRAGONHUB_ACTIVE then break end
                        if not IsCharacterOk() then WaitForCharacter() break end
                        if not target or not target.Parent then break end
                        local th = target:FindFirstChild("Humanoid")
                        if not th or th.Health <= 0 then break end
                        if target:FindFirstChild("HumanoidRootPart") then
                            SmartAttack(target)
                        else
                            break
                        end
                        task.wait()
                    until not _G.GlobalNPCFarm
                        or not _G.DRAGONHUB_ACTIVE
                        or not target or not target.Parent
                        or not target:FindFirstChild("Humanoid")
                        or target.Humanoid.Health <= 0
                        or not target:FindFirstChild("HumanoidRootPart")
                        or not IsCharacterOk()
                end

                -- Busca proximo NPC do mesmo tipo (sem espera)
                if _G.GlobalNPCFarm and _G.DRAGONHUB_ACTIVE then
                    local nextTarget = findNPC(npcTypeX, "IncludeUnderscore")
                    if nextTarget and nextTarget ~= target then
                        local myH = hrp()
                        local nxtHRP = nextTarget:FindFirstChild("HumanoidRootPart")
                        if myH and nxtHRP and (myH.Position - nxtHRP.Position).Magnitude > (_G.Adis or 5) * 2 then
                            local npcPos2 = nextTarget.WorldPivot.Position
                            local iName2, iData2 = GetClosestIsland(npcPos2)
                            moverParaNPC(nextTarget, iName2, iData2)
                        end
                    end
                end
            else
                noEnemyCount += 1
                if noEnemyCount > 200 then
                    TeleportToIsland(currentIsland)
                    noEnemyCount = 0
                end
            end

            -- Atualiza barra de progresso
            if updateBar and (tick() % 0.5 < 0.016) then
                local timeSinceStart = tick() - startTime
                local levelProgress = currentLevel - questData.minLevel
                local totalNeeded = questData.maxLevel - questData.minLevel
                local timeStr = ""
                if levelProgress > 0 and timeSinceStart > 0 then
                    local estimatedTime = ((timeSinceStart / levelProgress) * totalNeeded) - timeSinceStart
                    if estimatedTime > 0 then
                        timeStr = string.format(" | %dm%ds rest",
                            math.floor(estimatedTime / 60),
                            math.floor(estimatedTime % 60))
                    end
                end
                local hpStr = string.format("%.0f%% HP", _GF_GetHP())
                updateBar(currentLevel, 16000, questData.label .. " | " .. hpStr .. timeStr)
            end
        end)

        if (_G.GlobalNPCDelay or 0) > 0 then
            task.wait(_G.GlobalNPCDelay)
        end
    end
end

