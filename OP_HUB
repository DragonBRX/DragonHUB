    local function upd(mx)
        local ax=track.AbsolutePosition.X local aw=track.AbsoluteSize.X
        local pct=math.clamp((mx-ax)/math.max(aw,1),0,1)
        value=math.floor(minV+pct*range/step+0.5)*step value=math.clamp(value,minV,maxV)
        local v2=(value-minV)/range fill.Size=UDim2.new(v2,0,1,0) knob.Position=UDim2.new(v2,0,0.5,0)
        lbl.Text=(opts.Title or "")..":  "..tostring(value)
        if opts.Callback then pcall(opts.Callback,value) end
    end
    hit2.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then drag2=true upd(i.Position.X) end end)
    hit2.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then drag2=false end end)
    _uis.InputChanged:Connect(function(i) if drag2 and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then upd(i.Position.X) end end)
    if opts.Callback then pcall(opts.Callback,value) end
end

