_G.ModeAT = "Above"
_G.Adis = 20
_G.MultiHitCount  = 3
_G.AttackDelay    = 0
_G.OrbitalAngle   = 0
_G.OrbitalSpeed   = 45
_G.PredictiveTP   = false
_G.MultiHitMode   = false

-- getAttackPos: retorna offset de posição relativa ao NPC (sem rotação que quebra o personagem)
local function getAttackPos()
    local mode = _G.ModeAT or "Above"
    local d = _G.Adis or 20
    if mode == "Above" then
        -- Posição acima sem rotação no personagem
        return CFrame.new(0, d, 0)
    elseif mode == "Below" then
        return CFrame.new(0, -d, 0)
    elseif mode == "Behind" then
        return CFrame.new(0, 0, d)
    elseif mode == "Orbital" then
        _G.OrbitalAngle = (_G.OrbitalAngle + (_G.OrbitalSpeed or 45)) % 360
        local rad = math.rad(_G.OrbitalAngle)
        return CFrame.new(math.sin(rad) * d, 2, math.cos(rad) * d)
    elseif mode == "Random" then
        local rad = math.rad(math.random(0, 359))
        return CFrame.new(math.sin(rad) * d, math.random(-2, 4), math.cos(rad) * d)
    else
        return CFrame.new(0, 0, 0)
    end
end

-- Calcula posição de destino com ou sem predição
local function getPredictedCFrame(targetHRP)
    local offset = getAttackPos()
    if not _G.PredictiveTP or not targetHRP then
        return targetHRP.CFrame * offset
    end
    local vel = targetHRP.AssemblyLinearVelocity
    local predictedPos = targetHRP.CFrame + vel * 0.08
    return predictedPos * offset
end

-- Aguarda o personagem estar suficientemente perto do destino
-- Usado após TpTween para garantir que o ataque dispara no lugar certo
local function WaitArrival(destPos, threshold, timeout)
    threshold = threshold or 4
    timeout = timeout or 0.4
    local t0 = tick()
    repeat
        RunService.Heartbeat:Wait()
        local h = hrp()
        if not h then return false end
        if (h.Position - destPos).Magnitude <= threshold then return true end
    until (tick() - t0) >= timeout
    return false
end

local function FastAttack(target, n)
    if not target then return end
    local hits = n or _G.MultiHitCount or 3
    local delay = _G.AttackDelay or 0
    for _ = 1, hits do
        local cok = target:FindFirstChild("HumanoidRootPart")
        if not cok then break end
        local hum = target:FindFirstChild("Humanoid")
        if not hum or hum.Health <= 0 then break end
        local dest = getPredictedCFrame(cok)
        -- FastAttack usa TPInstant pois precisa de velocidade máxima
        TPInstant(dest)
        CombatRemote:FireServer(cok.Position)
        if delay > 0 then task.wait(delay) end
    end
end

local function SmartAttack(target)
    if not target then return end
    local cok = target:FindFirstChild("HumanoidRootPart")
    if not cok then return end
    local hum = target:FindFirstChild("Humanoid")
    if not hum or hum.Health <= 0 then return end

    if _G.MultiHitMode then
        FastAttack(target, _G.MultiHitCount)
        AktifSkill()
        return
    end

    -- Se Pull estiver ativo, personagem fica parado: só ataca sem mover
    if _G.PullEnabled then
        CombatRemote:FireServer(cok.Position)
        AktifSkill()
        return
    end

    local destCF = getPredictedCFrame(cok)
    local myHrp = hrp()
    
    -- Só teleporta se estiver longe (evita teleportes múltiplos desnecessários)
    if myHrp and (myHrp.Position - destCF.Position).Magnitude > 5 then
        TPInstant(destCF)
        _anchorHRP(destCF.Position)
    end

    -- Re-checa alvo após teleporte
    cok = target:FindFirstChild("HumanoidRootPart")
    if not cok then _clearAlign() return end
    hum = target:FindFirstChild("Humanoid")
    if not hum or hum.Health <= 0 then _clearAlign() return end

    CombatRemote:FireServer(cok.Position)
    AktifSkill()
end

