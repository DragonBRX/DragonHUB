local function IsCharacterOk()
    local char = LP.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    local hrpCheck = char:FindFirstChild("HumanoidRootPart")
    if not hrpCheck then return false end
    if hrpCheck.Position.Y < -100 then return false end
    return true
end

local function WaitForCharacter()
    local attempts = 0
    while not IsCharacterOk() and attempts < 40 do
        task.wait(0.5)
        attempts += 1
    end
    local ok = IsCharacterOk()
    if not ok then
        warn("[DragonHUB] Personagem não disponível após espera – tentando respawn")
        pcall(function()
            LP:LoadCharacter()
        end)
        task.wait(3)
    end
    return IsCharacterOk()
end

-- Loop do Pull em background
task.spawn(function()
    while _G.DRAGONHUB_ACTIVE do
        local delay = math.max(_G.PullDelay or 0.3, 0.05)
        task.wait(delay)
        if _G.PullEnabled and IsCharacterOk() then
