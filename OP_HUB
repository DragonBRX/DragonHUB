-- AlignPosition ativo (âncora no ar)
local _alignPos = nil
local _alignAtt = nil

local function _clearAlign()
    pcall(function()
        if _alignAtt then _alignAtt:Destroy() end
        if _alignPos then _alignPos:Destroy() end
    end)
    _alignAtt = nil
    _alignPos = nil
end

-- Âncora o personagem no ar usando AlignPosition (físico, aceito pelo servidor)
local function _anchorHRP(targetPos)
    _clearAlign()
    local hrpNow = hrp()
    if not hrpNow then return end
    local att = Instance.new("Attachment")
    att.Parent = hrpNow
    local ap = Instance.new("AlignPosition")
    ap.Mode = Enum.PositionAlignmentMode.OneAttachment
    ap.Attachment0 = att
    ap.Position = targetPos
    ap.MaxForce = math.huge
    ap.MaxVelocity = 300
    ap.Responsiveness = 200
    ap.ApplyAtCenterOfMass = true
    ap.Parent = hrpNow
    _alignAtt = att
    _alignPos = ap
end

-- TpTween: usa AlignPosition para mover suavemente sem quebrar o servidor
-- Para distâncias > 400: usa CFrame direto (único teleporte seguro para respawn)
function TpTween(Pos)
    local hrpNow = hrp()
    if not hrpNow then return end
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end

    local dist = (hrpNow.Position - Pos.Position).Magnitude

    -- Distância muito grande: teleporte direto aceitável pelo servidor
    if dist > 400 then
        _clearAlign()
        hrpNow.CFrame = Pos
        return
    end

    if dist < 3 then return end

    -- Move via AlignPosition (movimento físico real, não manipulação de CFrame)
    _anchorHRP(Pos.Position)

    -- Espera chegar ou timeout de 2.5s
    local t0 = tick()
    repeat
        RunService.Heartbeat:Wait()
        hrpNow = hrp()
        if not hrpNow then break end
    until not hrpNow
        or (hrpNow.Position - Pos.Position).Magnitude < 3.5
        or (tick() - t0) > 2.5

    -- Finaliza a posição e remove o alinhamento
    if hrpNow then
        hrpNow.AssemblyLinearVelocity = Vector3.zero
    end
    _clearAlign()
end

-- TPInstant: mantém o CFrame direto para casos onde velocidade é crítica
-- (ataque instantâneo, pull, boss)
function TPInstant(Pos)
    local hrpNow = hrp()
    if not hrpNow then return end
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end
    _clearAlign()
    hrpNow.AssemblyLinearVelocity = Vector3.zero
    hrpNow.AssemblyAngularVelocity = Vector3.zero
    hrpNow.CFrame = Pos
end

function TP(Pos)
    if _G.SelectModeTP == "Instant" then
        TPInstant(Pos)
    else
        TpTween(Pos)
    end
end

