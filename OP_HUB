-- FARM DE MOB SELECIONADO
task.spawn(function()
    while _G.DRAGONHUB_ACTIVE do
        task.wait(0.1)
        local ok, err = pcall(function()
            if _G.PrioriySystem or _G.PrioriySystem2 then return end
            if not _G.StartingAUfarm then return end
            if not selectedNPCs or #selectedNPCs == 0 then return end
            if not IsCharacterOk() then WaitForCharacter() return end

            for _, name in ipairs(selectedNPCs) do
                if not _G.StartingAUfarm then break end
                if not _G.DRAGONHUB_ACTIVE then break end
                if _G.PrioriySystem or _G.PrioriySystem2 then break end
                if not IsCharacterOk() then WaitForCharacter() break end

                local target = findNPC(name, "IncludeUnderscore")
                if not target then task.wait(1) continue end

                local hum = target:FindFirstChild("Humanoid")
                if not hum or hum.Health <= 0 then continue end

                _G._InstantTarget = target

                if _G.StartQuest then
                    if not GetCurrentQuestTitle() then
                        GetQuest(name)
                        task.wait(0.5)
                    end
                end

                local npcPos = target.WorldPivot.Position
                local islandName, islandData = GetClosestIsland(npcPos)
                if not moverParaNPC(target, islandName, islandData) then continue end

                repeat
                    if not _G.StartingAUfarm or not _G.DRAGONHUB_ACTIVE then break end
                    if _G.PrioriySystem or _G.PrioriySystem2 then break end
                    if not IsCharacterOk() then WaitForCharacter() break end
                    if not target or not target.Parent then break end
                    local th = target:FindFirstChild("Humanoid")
                    if not th or th.Health <= 0 then break end
                    if target:FindFirstChild("HumanoidRootPart") then
                        SmartAttack(target)
                    else
                        break
                    end
                    task.wait()
                until not _G.StartingAUfarm
                    or not _G.DRAGONHUB_ACTIVE
                    or _G.PrioriySystem or _G.PrioriySystem2
                    or not target or not target.Parent
                    or not target:FindFirstChild("Humanoid")
                    or target.Humanoid.Health <= 0
                    or not target:FindFirstChild("HumanoidRootPart")
                    or not IsCharacterOk()

