    fill.Parent            = barBg

    local pctLbl = Instance.new("TextLabel")
    pctLbl.Size                  = UDim2.new(1, 0, 1, 0)
    pctLbl.BackgroundTransparency = 1
    pctLbl.TextColor3            = Color3.fromRGB(255, 255, 255)
    pctLbl.TextSize              = 10
    pctLbl.Font                  = Enum.Font.GothamBold
    pctLbl.Text                  = "0%"
    pctLbl.Parent                = barBg

    return function(level, maxLevel, mission)
        level     = level     or 0
        maxLevel  = maxLevel  or 16000
        mission   = mission   or "Aguardando..."
        levelLbl.Text   = "Level: " .. level .. "/" .. maxLevel
        missionLbl.Text = "Missao: " .. mission
        local pct = math.floor((level / maxLevel) * 100)
        fill.Size   = UDim2.new(math.min(pct / 100, 1), 0, 1, 0)
        pctLbl.Text = pct .. "%"
    end
end

local function _GF_DestroyBar()
    if _GF_BarGui then
        pcall(function() _GF_BarGui:Destroy() end)
        _GF_BarGui = nil
    end
end

