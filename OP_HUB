local function _GF_GetLevel()
    local ok, val = pcall(function() return LP.Data.Level.Value end)
    return (ok and val) or 0
end

local function _GF_GetHP()
    local char = LP.Character
    if not char then return 0 end
    local hum = char:FindFirstChild("Humanoid")
    if not hum then return 0 end
    return (hum.Health / hum.MaxHealth) * 100
end

local function _GF_GetQuestForLevel()
    local level = _GF_GetLevel()
    local best = nil
    for _, data in ipairs(_GF_QuestData) do
        if level >= data.minLevel and level <= data.maxLevel then
            best = data
            break
        end
    end
    if not best then
        for i = #_GF_QuestData, 1, -1 do
            if level >= _GF_QuestData[i].minLevel then
                best = _GF_QuestData[i]
                break
            end
        end
    end
    return best
end

