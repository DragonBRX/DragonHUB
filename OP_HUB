    local track=Instance.new("Frame") track.Size=UDim2.new(1,-18,0,6) track.Position=UDim2.new(0,9,0,30) track.BackgroundColor3=C.off track.BorderSizePixel=0 track.Parent=row _c(track,3)
    local p0=(value-minV)/range
    local fill=Instance.new("Frame") fill.Size=UDim2.new(p0,0,1,0) fill.BackgroundColor3=C.acc fill.BorderSizePixel=0 fill.Parent=track _c(fill,3)
    local knob=Instance.new("Frame") knob.Size=UDim2.new(0,18,0,18) knob.AnchorPoint=Vector2.new(0.5,0.5) knob.Position=UDim2.new(p0,0,0.5,0) knob.BackgroundColor3=C.white knob.BorderSizePixel=0 knob.ZIndex=4 knob.Parent=track _c(knob,9)
