local function EV_FindBunny()
    local npcs = workspace:FindFirstChild("NPCs")
    if not npcs then return nil end
    for _, v in ipairs(npcs:GetChildren()) do
        local n = v.Name:lower()
        if (n:find("bunny") or n:find("easter")) and not n:find("boss") then
            local h = v:FindFirstChildOfClass("Humanoid")
            if h and h.Health > 0 then return v end
        end
    end
    return nil
end

local function EV_FindGreatMage()
    local npcs = workspace:FindFirstChild("NPCs")
